# Copy this file to .env and fill in your values. Never commit .env (it is in .gitignore).
#
# The course is GCP-native: Application Default Credentials everywhere
# (`gcloud auth application-default login` locally, the auth cell on Colab). No API keys.

PROJECT_ID=documind-ai-YOUR-ID
REGION=us-central1        # the regional services (embeddings, tuning, evaluation, Cloud Run on the lean lane)
                          # Firestore and the buckets live in asia-south1 - the kit's Terraform sets that, not you

# Optional - only if a lesson tells you to pull a model from Hugging Face
# HF_TOKEN=
